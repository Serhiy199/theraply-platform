# App / NextAuth
DATABASE_URL="postgresql://user:password@localhost:5432/theraply"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="<generate-a-strong-auth-secret>"

# Cron / Security
CRON_SECRET="<generate-a-strong-cron-secret>"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<stripe-publishable-key>"
STRIPE_SECRET_KEY="<stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<stripe-webhook-secret>"
# Optional, distinct Connected accounts destination secret; leave unset until configured.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Google OAuth / Calendar
GOOGLE_CLIENT_ID="<google-client-id>"
GOOGLE_CLIENT_SECRET="<google-client-secret>"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# SMTP / Email
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user@example.com"
SMTP_PASS="<smtp-password>"
EMAIL_FROM="smtp_user@example.com"
EMAIL_REPLY_TO="support@example.com"

# Cloudinary certificate uploads
CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<cloudinary-api-key>"
CLOUDINARY_API_SECRET="<cloudinary-api-secret>"
CLOUDINARY_CERTIFICATES_FOLDER="theraply/therapist-certificates"
CLOUDINARY_THERAPIST_PHOTOS_FOLDER="theraply/therapist-photos"

# Monitoring
ERROR_MONITORING_PROVIDER="console"
SENTRY_DSN=""

# Optional Wix Forms therapist application intake
WIX_API_TOKEN=""
WIX_SITE_ID="<wix-site-id>"
WIX_THERAPIST_APPLICATION_FORM_ID="<wix-form-id>"
WIX_ACCOUNT_ID=""

# Wix CMS therapist directory (separate credentials; no Forms-token fallback)
# Development/staging CMS token:
WIX_CMS_API_TOKEN=""
# Production-only CMS token (required only with WIX_CMS_ENVIRONMENT=production):
WIX_CMS_API_TOKEN_PRODUCTION=""
WIX_CMS_ENVIRONMENT="<dev-development-staging-or-production>"
WIX_CMS_SITE_ID="<wix-cms-site-id>"
# Explicit write activation; keep false until environment-specific CMS acceptance.
WIX_CMS_AUTOMATION_ENABLED="false"
# Production requires:
# WIX_CMS_ENVIRONMENT="production"
# WIX_CMS_SITE_ID="1ce946b1-1bcb-4b89-a1b5-86358d639333"
# One isolated staging TherapistProfile CUID; empty blocks staging Wix writes.
# Outside staging, the variable has no effect on normal Wix synchronization.
# Effective only on the dedicated Vercel develop staging project + staging DB.
# Never configure on production VPS. No readiness or approval bypass.
# Allowed values: empty, or one exact TherapistProfile ID (not a list/email).
# Requires VERCEL=1, the dedicated staging VERCEL_PROJECT_ID, develop branch,
# APP_URL=https://theraply-platform.vercel.app, WIX_CMS_ENVIRONMENT=staging,
# and postgres/public on Prisma. A canonical root URL may have a trailing slash.
# Missing/invalid isolation config or context blocks Wix writes in staging.
# Production keeps normal behavior; it must not claim the staging context.
# Before approval, require the admin row's "Wix suppressed: staging isolation"
# badge for that exact profile; otherwise STOP. Suppression never marks SYNCED.
WIX_STAGING_ISOLATED_PROFILE_ID=
