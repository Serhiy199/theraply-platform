# Copy this file to .env.production.local
# Paste the Vercel / Prisma Postgres DATABASE_URL here.
# This file is primarily for remote database maintenance commands.
# App and integration values can be added here when you need to validate
# production-like OAuth or callback configuration locally.

DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_PRISMA_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_POSTGRES_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
APP_URL="https://app.example.com"
NEXT_PUBLIC_APP_URL="https://app.example.com"
NEXTAUTH_URL="https://app.example.com"
AUTH_SECRET="<generate-with-openssl-rand-hex-32>"
CRON_SECRET="<generate-with-openssl-rand-hex-32>"
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"
GOOGLE_CALENDAR_REDIRECT_URI="https://app.example.com/api/integrations/google/callback"
# Hosted Stripe testing:
# - use Stripe test keys for Vercel preview / test environments
# - set STRIPE_WEBHOOK_SECRET to the signing secret of the hosted test webhook endpoint
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="no-reply@theraply.co.uk"
SMTP_PASS="<google-workspace-app-password>"
EMAIL_FROM="no-reply@theraply.co.uk"
EMAIL_REPLY_TO="support@theraply.co.uk"
CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<cloudinary-api-key>"
CLOUDINARY_API_SECRET="<cloudinary-api-secret>"
CLOUDINARY_CERTIFICATES_FOLDER="theraply/therapist-certificates"
ERROR_MONITORING_PROVIDER="console"
SENTRY_DSN=""
