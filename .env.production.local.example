# Copy this file to .env.production.local.
# Keep this example commit-safe: use placeholders only, never real credentials.

DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_PRISMA_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_POSTGRES_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
APP_URL="https://platform.theraply.online"
NEXT_PUBLIC_APP_URL="https://platform.theraply.online"
NEXTAUTH_URL="https://platform.theraply.online"
AUTH_SECRET="<generate-with-openssl-rand-hex-32>"
CRON_SECRET="<generate-with-openssl-rand-hex-32>"

GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"
GOOGLE_CALENDAR_REDIRECT_URI="https://platform.theraply.online/api/integrations/google/callback"

# Hosted Stripe testing:
# - use Stripe test keys for test environments
# - set STRIPE_WEBHOOK_SECRET to the matching test webhook signing secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<stripe-publishable-key>"
STRIPE_SECRET_KEY="<stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<stripe-webhook-secret>"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user@example.com"
SMTP_PASS="<smtp-password>"
EMAIL_FROM="smtp_user@example.com"
EMAIL_REPLY_TO="support@example.com"

CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<cloudinary-api-key>"
CLOUDINARY_API_SECRET="<cloudinary-api-secret>"
CLOUDINARY_CERTIFICATES_FOLDER="theraply/therapist-certificates"
CLOUDINARY_THERAPIST_PHOTOS_FOLDER="theraply/therapist-photos"

# Wix Forms and Wix CMS use separate credentials. Never fall back between them.
WIX_API_TOKEN="<wix-forms-api-token>"
WIX_SITE_ID="<wix-forms-site-id>"
WIX_THERAPIST_APPLICATION_FORM_ID="<wix-form-id>"
WIX_ACCOUNT_ID=""
# Development/staging CMS token. Production never falls back to this value.
WIX_CMS_API_TOKEN=""
# Production-only CMS token.
WIX_CMS_API_TOKEN_PRODUCTION="<dedicated-production-wix-cms-api-token>"
WIX_CMS_ENVIRONMENT="production"
WIX_CMS_SITE_ID="1ce946b1-1bcb-4b89-a1b5-86358d639333"

ERROR_MONITORING_PROVIDER="console"
SENTRY_DSN=""
